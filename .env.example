# ------------------------------------------------------------------------------
# TenantMind AI - Local Environment Variables
# ------------------------------------------------------------------------------

# MongoDB Atlas configuration
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/platform_db?retryWrites=true&w=majority

# Keycloak Identity Provider
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=tenantmind
KEYCLOAK_CLIENT_ID=backend-client
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333

# Redis Cache and Message Broker
REDIS_URL=redis://localhost:6379/0

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=adminpassword
MINIO_SECURE=false

# Ollama local LLM and embedding server
OLLAMA_BASE_URL=http://localhost:11434

LLM_FALLBACK_PROVIDERS=gemini,nvidia,groq,huggingface,mistral,deepseek,openai,ollama
EMBEDDING_FALLBACK_PROVIDERS=gemini,nvidia,openai,huggingface,ollama

# Cloud LLM Provider API Keys
EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

NVIDIA_API_KEY=your-nvidia-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
GROQ_API_KEY=your-groq-api-key
MISTRAL_API_KEY=your-mistral-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_CHAT_MODEL=claude-3-opus-20240229

# LangSmith Observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tenantmind-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Global application timezone
APP_TIMEZONE=Asia/Kolkata
